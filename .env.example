# ==============================================================================
# DENTRACE - Environment Configuration Template
# Copy this file to .env and adjust as necessary for your local environment.
# DO NOT COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# API Server Configuration
DENTRACE_API_HOST=127.0.0.1
DENTRACE_API_PORT=8000
DENTRACE_LOG_LEVEL=INFO

# Local Ollama LLM Configuration (Default: localhost only)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_ALT_MODEL=phi3:mini
OLLAMA_TIMEOUT_SECONDS=45

# Inference Engine Settings
# Options: mock | onnx | pytorch
DENTRACE_INFERENCE_MODE=mock
DENTRACE_CONF_THRESHOLD=0.35
DENTRACE_IOU_THRESHOLD=0.45

# Storage & Cache Paths (Relative or mapped to high-capacity drive like C:)
# IMPORTANT: D: drive has limited capacity (~4.5 GB); point large caches to C:
DENTRACE_DATASETS_DIR=datasets
DENTRACE_MODELS_DIR=models
DENTRACE_REPORTS_DIR=reports/generated

# Clinical Safety & Telemetry
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
DENTRACE_ALLOW_EXTERNAL_EGRESS=false
